# Credentials cho test accounts — copy file này thành .env.test và điền giá trị thật.
# .env.test bị gitignore, không commit credential thật lên repo.
#
# Sau khi tạo .env.test, chạy auth setup 1 lần cho mỗi user cần dùng:
#   pnpm exec playwright test auth.setup.ts
#   TEST_USER=<key> pnpm exec playwright test auth.setup.ts

# ── TODO: đổi key theo USERS catalog trong auth.fixture.ts ────────────────
USER_DEFAULT_EMAIL=your-email@company.com
USER_DEFAULT_PASSWORD=your-password

# ── Thêm role mới theo pattern ─────────────────────────────────────────────
# USER_<KEY>_EMAIL=...
# USER_<KEY>_PASSWORD=...

# ── URL override — mặc định đọc từ playwright.config.ts ───────────────────
# BASE_URL=https://staging.example.com
